// Models are added per feature (see docs/data-and-api.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Workers cannot compile WebAssembly at runtime; this imports the query
  // compiler as a .wasm module instead (docs/data-and-api.md).
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  customers   Customer[]
  contacts    Contact[]
  deals       Deal[]
  activities  Activity[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ── CRM ────────────────────────────────────────────────────────────────────
// Every tenant-owned model has tenantId (the Better Auth organization) and is
// listed in TENANT_MODELS in src/server/tenant-db.ts.

enum CustomerStatus {
  active
  archived
}

model Customer {
  id             String         @id @default(uuid(7))
  tenantId       String
  tenant         Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  /// lower(trim(name)): enforces case-insensitive uniqueness per workspace (rule 6)
  nameNormalized String
  industry       String?
  website        String?
  email          String?
  phone          String?
  address        String?
  status         CustomerStatus @default(active)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  contacts       Contact[]
  deals          Deal[]
  activities     Activity[]

  @@unique([tenantId, nameNormalized])
  @@index([tenantId, status, nameNormalized])
  @@map("customers")
}

model Contact {
  id         String       @id @default(uuid(7))
  tenantId   String
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Set on create, never changed (docs/project.md). Customers are never deleted.
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  firstName  String
  lastName   String
  jobTitle   String?
  email      String?
  phone      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deals      Deal[]
  activities Activity[]

  @@index([tenantId, customerId, lastName, firstName])
  @@map("contacts")
}

enum DealStage {
  lead
  qualified
  proposal
  negotiation
  won
  lost
}

enum Currency {
  EUR
  USD
  GBP
}

model Deal {
  id                String       @id @default(uuid(7))
  tenantId          String
  tenant            Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title             String
  /// lower(trim(title)): case-insensitive search and sort
  titleNormalized   String
  /// Fixed after create (rule 13). Customers are never deleted.
  customerId        String
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Cleared when the contact is deleted (rule 13).
  contactId         String?
  contact           Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  value             Decimal      @db.Decimal(12, 2)
  currency          Currency     @default(EUR)
  stage             DealStage    @default(lead)
  expectedCloseDate DateTime?    @db.Date
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  activities        Activity[]

  @@index([tenantId, titleNormalized])
  @@index([tenantId, customerId, titleNormalized])
  @@index([tenantId, stage])
  @@map("deals")
}

enum ActivityType {
  call
  meeting
  email
  task
}

model Activity {
  id         String       @id @default(uuid(7))
  tenantId   String
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       ActivityType @default(call)
  subject    String
  notes      String?
  /// When it happened; for a task, when it is due (rule 27).
  date       DateTime     @db.Date
  /// Fixed after create (rule 24). Customers are never deleted.
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Cleared when the contact is deleted (rule 26).
  contactId  String?
  contact    Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Cleared when the deal is deleted (rule 26).
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  /// Tasks only; always false for other types (rule 27).
  done       Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([tenantId, type, done, date])
  @@index([tenantId, date])
  @@index([tenantId, customerId, date])
  @@index([tenantId, dealId])
  @@map("activities")
}
