# Local development values. Copy to `.env`; `.env` is never committed.
# `bun run <script>` loads it for the Prisma CLI and tests, and Wrangler loads
# it for the local Worker. Production values are Worker secrets (docs/devops.md).

# Local Docker Postgres. The app reaches it through the Neon proxy on port
# 5433 (localhost URLs are routed there automatically); the Prisma CLI uses
# port 55432 directly (the container; 5432 is often a local PostgreSQL).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/crm

# Database for integration tests (`bun run test`).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/crm_test

# Better Auth. The secret signs sessions: at least 32 random characters
# (`openssl rand -base64 32`). The URL is where the app is served.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Rate limits (Upstash Redis REST). Locally: the redis-rest container.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

# Email. `mailpit` locally (inbox at http://localhost:8025), `resend` in
# production (needs RESEND_API_KEY and a verified sending domain).
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://localhost:8025
EMAIL_FROM=CRM <crm@example.test>
# RESEND_API_KEY=
