# Local development values. Copy to `.env`; `.env` is never committed.
# `bun run <script>` loads it for the Prisma CLI and tests, and Wrangler loads
# it for the local Worker. Production values are Worker secrets (docs/devops.md).

# Local Docker Postgres. The app reaches it through the Neon proxy on port
# 5433 (localhost URLs are routed there automatically); the Prisma CLI uses
# port 5432 directly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm

# Database for integration tests (`bun run test`).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_test
